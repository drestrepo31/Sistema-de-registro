      "cell_type": "code",
      "source": [
        "# ================================================================\n",
        "# @title 📋 Datos del inventario del proyecto\n",
        "\n",
        "print(\"=\" * 65)\n",
        "print(\"  INGRESE LAS CANTIDADES REALES DEL PROYECTO\")\n",
        "print(\"  (presiona ENTER para aceptar el valor extraído del PDF)\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "\n",
        "def ask_int(prompt, default=None):\n",
        "    hint = f\" [PDF: {int(default)}]\" if default is not None else \"\"\n",
        "    while True:\n",
        "        raw = input(f\"{prompt}{hint}: \").strip()\n",
        "        if raw == \"\" and default is not None:\n",
        "            return int(default)\n",
        "        try:\n",
        "            return int(raw)\n",
        "        except ValueError:\n",
        "            print(\"  ⚠️  Ingrese un número entero.\")\n",
        "\n",
        "\n",
        "def ask_float(prompt, default=None):\n",
        "    hint = f\" [PDF: {default}]\" if default is not None else \"\"\n",
        "    while True:\n",
        "        raw = input(f\"{prompt}{hint}: \").strip()\n",
        "        if raw == \"\" and default is not None:\n",
        "            return float(default)\n",
        "        try:\n",
        "            return float(raw)\n",
        "        except ValueError:\n",
        "            print(\"  ⚠️  Ingrese un número válido.\")\n",
        "\n",
        "\n",
        "p  = parser.data[\"panels\"];  b  = parser.data[\"batteries\"]\n",
        "iv = parser.data[\"inverter\"]; ld = parser.data[\"load\"]\n",
        "bt = parser.data[\"battery_temp\"]\n",
        "\n",
        "print()\n",
        "inv_paneles  = ask_int  (\"Ingrese cantidad de paneles solares de 625 Wp\",   p[\"count\"])\n",
        "inv_baterias = ask_int  (\"Ingrese la cantidad de baterias Shoto de 100 Ah\", b[\"count\"])\n",
        "inv_mppTs    = ask_int  (\"Ingrese la cantidad de MPPTs\",                    iv[\"total_mppt\"])\n",
        "inv_soc_min  = ask_float(\"Ingrese el %SOC mínimo configurado\",              b[\"soc_min_pct\"])\n",
        "inv_temp_amb = ask_float(\"Ingrese la temperatura ambiente esperada en la \"\n",
        "                         \"ubicación del banco de baterías (°C)\",            bt[\"design_temp_c\"])\n",
        "\n",
        "# Carga promedio: derivada automáticamente del PDF — E_Load(año) / 8760\n",
        "# No se solicita al usuario; el valor de PVsyst es la fuente de verdad.\n",
        "inv_carga_kw = ld[\"average_kw\"]\n",
        "\n",
        "_eload_str = f\"{ld['annual_kwh']:,} kWh/año\" if ld[\"annual_kwh\"] else \"no disponible\"\n",
        "print(\"\\n✅ Datos del inventario confirmados:\")\n",
        "print(f\"   Paneles 625 Wp          : {inv_paneles}\")\n",
        "print(f\"   Baterías Shoto 100 Ah   : {inv_baterias}\")\n",
        "print(f\"   MPPTs                   : {inv_mppTs}\")\n",
        "print(f\"   %SOC mínimo             : {inv_soc_min} %\")\n",
        "print(f\"   Temp. ambiente baterías : {inv_temp_amb} °C\")\n",
        "#print(f\"   Carga promedio (auto)   : \"\n",
        "      #f\"{inv_carga_kw if inv_carga_kw is not None else '—'} kW\"\n",
        "      #f\"  ← E_Load {_eload_str} ÷ 8760 h\")"
      ],
      "metadata": {
