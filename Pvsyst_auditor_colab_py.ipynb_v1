    {
      "cell_type": "code",
      "source": [
        "# ================================================================\n",
        "# @title 📊 Reporte de Auditoría PVsyst\n",
        "\n",
        "# ── Constantes de auditoría ───────────────────────────────────────────────────\n",
        "TOL_GENERAL  = 5.0    # tolerancia % en comparaciones de inventario\n",
        "TOL_SOC      = 2.0    # tolerancia estricta para SOC\n",
        "PANEL_NOM_WP = 625    # potencia nominal esperada (Wp)\n",
        "BATT_NOM_AH  = 100    # capacidad nominal esperada por batería (Ah)\n",
        "SOIL_MIN_JAM = 10.0   # suciedad mínima aceptable en Jamaica/Barbados\n",
        "SOIL_MAX     = 20.0   # suciedad máxima razonable\n",
        "MISS_WARN    = 10.0   # % de E_Miss que dispara advertencia (solo informativo)\n",
        "MISS_ERROR   = 30.0   # % de E_Miss que dispara nota alta (solo informativo)\n",
        "TEMP_MARGIN  = 8.0    # diferencia temp. ambiente vs diseño batería (°C) que alerta\n",
        "BATT_MAX_TEMP= 45.0   # temperatura máxima operación LFP (°C)\n",
        "\n",
        "\n",
        "def _ok(cond):\n",
        "    return \"✅\" if cond else \"❌\"\n",
        "\n",
        "\n",
        "def _compare(label, pdf_val, user_val, tol=TOL_GENERAL, unit=\"\", from_variant=False):\n",
        "    \"\"\"Compara valor PDF vs ingresado. Retorna (ok|None, línea).\"\"\"\n",
        "    suf    = f\" {unit}\" if unit else \"\"\n",
        "    source = \"[variante]\" if from_variant else \"PDF\"\n",
        "    if pdf_val is None:\n",
        "        return None, (f\"   ⚠️  {label}: no encontrado en {source}  \"\n",
        "                      f\"(ingresado: {user_val}{suf})\")\n",
        "    delta = abs(pdf_val - user_val)\n",
        "    rel   = (delta / abs(pdf_val) * 100) if pdf_val else 0\n",
        "    ok    = rel <= tol\n",
        "    msg   = \"COINCIDE\" if ok else f\"DISCREPANCIA  Δ={delta:.2f}{suf}  ({rel:.1f}%)\"\n",
        "    return ok, (f\"   {_ok(ok)} {label}:  inventario={user_val}{suf}  \"\n",
        "                f\"│  {source}={pdf_val:.2f}{suf}  │  {msg}\")\n",
        "\n",
        "\n",
        "def _is_caribbean(site_dict):\n",
        "    texto = \" \".join([site_dict.get(\"name\",\"\"), site_dict.get(\"country\",\"\")]).lower()\n",
        "    return any(k in texto for k in\n",
        "               [\"jamaica\",\"barbados\",\"carib\",\"kingston\",\"bridgetown\",\"trinidad\"])\n",
        "\n",
        "\n",
        "def generate_audit():\n",
        "    issues = []    # (severity, message)   'error' | 'warning'\n",
        "\n",
        "    # ── Encabezado (imprime primero, antes de cualquier cómputo) ─────────────\n",
        "    W = 68\n",
        "    print(\"\\n\")\n",
        "    print(\"╔\" + \"═\" * W + \"╗\")\n",
        "    print(\"║\" + \"  REPORTE DE AUDITORÍA PVSYST — SISTEMA SOLAR AISLADO\".center(W) + \"║\")\n",
        "    print(\"║\" + f\"  Variante: {variant_name}\".ljust(W) + \"║\")\n",
        "    print(\"╚\" + \"═\" * W + \"╝\")\n",
        "\n",
        "    texto_chars = len(parser.full_text.strip())\n",
        "    if texto_chars < 300:\n",
        "        print(f\"⚠️  ADVERTENCIA: Texto extraído muy corto ({texto_chars} chars).\")\n",
        "        print(\"   Posible problema con la extracción. Campos no encontrados se\")\n",
        "        print(\"   completarán desde el nombre de variante.\\n\")\n",
        "\n",
        "    d    = parser.data\n",
        "    p    = d[\"panels\"];    b  = d[\"batteries\"];  iv = d[\"inverter\"]\n",
        "    lo   = d[\"losses\"];    ld = d[\"load\"];        e  = d[\"energy\"]\n",
        "    site = d[\"site\"];      bt = d[\"battery_temp\"]\n",
        "\n",
        "    cap_per_bat = None\n",
        "    if b[\"capacity_ah\"] and b[\"count\"]:\n",
        "        cap_per_bat = round(b[\"capacity_ah\"] / b[\"count\"], 1)\n",
        "\n",
        "    # ══════════════════════════════════════════════════════════════════════════\n",
        "    # PUNTO 1 — VERIFICACIÓN DE INVENTARIO\n",
        "    # ══════════════════════════════════════════════════════════════════════════\n",
        "    print(\"\\n\" + \"═\" * 68)\n",
        "    print(\"  PUNTO 1: VERIFICACIÓN DE INVENTARIO\")\n",
        "    print(\"═\" * 68)\n",
        "\n",
        "    # ─── Paneles ──────────────────────────────────────────────────────────────\n",
        "    ok_p, line = _compare(\"Paneles 625 Wp\", p[\"count\"], inv_paneles,\n",
        "                           from_variant=p.get(\"_from_variant\", False))\n",
        "    print(line)\n",
        "    if ok_p is False:\n",
        "        issues.append((\"error\", f\"Paneles: ingresado={inv_paneles} vs PDF={p['count']}\"))\n",
        "    if p[\"power_wp\"] is not None:\n",
        "        diff = abs(p[\"power_wp\"] - PANEL_NOM_WP)\n",
        "        src  = \"[variante]\" if p.get(\"_from_variant\") else \"PDF\"\n",
        "        icon = _ok(diff <= 10)\n",
        "        print(f\"   {icon} Potencia unitaria en {src}: {p['power_wp']} Wp  \"\n",
        "              f\"(especificado: {PANEL_NOM_WP} Wp\"\n",
        "              f\"{'  ✓' if diff<=10 else f'  Δ={diff:.0f} Wp'})\")\n",
        "        if diff > 10:\n",
        "            issues.append((\"warning\",\n",
        "                f\"Panel en PVsyst es {p['power_wp']} Wp, no {PANEL_NOM_WP} Wp\"))\n",
        "\n",
        "    # ─── Carga ────────────────────────────────────────────────────────────────\n",
        "    # Derivada automáticamente del PDF: E_Load(año) / 8760 — sin comparación manual.\n",
        "   # if ld[\"average_kw\"] is not None:\n",
        "       # _eload_disp = f\"{ld['annual_kwh']:,}\" if ld[\"annual_kwh\"] else \"—\"\n",
        "        #_src = \"[variante]\" if ld.get(\"_from_variant\") else \"PDF\"\n",
        "        #print(f\"   ℹ️  Carga promedio ({_src}): {ld['average_kw']:.3f} kW\"\n",
        "              #f\"  ← E_Load {_eload_disp} kWh/año ÷ 8760 h\")\n",
        "    #else:\n",
        "        #print(\"   ⚠️  Carga promedio: no encontrada en el PDF (E_Load no extraído).\")\n",
        "        #issues.append((\"warning\",\n",
        "            #\"Carga promedio no extraída del PDF — E_Load no encontrado en tabla de resultados.\"))\n",
        "\n",
        "    # ─── Baterías (packs) ─────────────────────────────────────────────────────\n",
        "    ok_b, line = _compare(\"Baterías Shoto (packs)\", b[\"count\"], inv_baterias,\n",
        "                           from_variant=b.get(\"_from_variant\", False))\n",
        "    print(line)\n",
        "    if ok_b is False:\n",
        "        issues.append((\"error\", f\"Baterías: ingresado={inv_baterias} vs PDF={b['count']}\"))\n",
        "\n",
        "    if cap_per_bat is not None:\n",
        "        diff_ah = abs(cap_per_bat - BATT_NOM_AH)\n",
        "        icon    = _ok(diff_ah <= 5)\n",
        "        cap_src = \"[variante]\" if b.get(\"_from_variant\") else \"PDF\"\n",
        "        print(f\"   {icon} Capacidad total {cap_src}: {b['capacity_ah']} Ah  \"\n",
        "              f\"→  {b['count']} packs × {cap_per_bat} Ah/pack  \"\n",
        "              f\"({'≈ 100 Ah/pack ✓' if diff_ah <= 5 else f'≠ {BATT_NOM_AH} Ah especificado'})\")\n",
        "        if diff_ah > 5:\n",
        "            issues.append((\"warning\",\n",
        "                f\"Capacidad por pack en PVsyst es {cap_per_bat} Ah, no {BATT_NOM_AH} Ah\"))\n",
        "    elif b[\"capacity_ah\"] is not None:\n",
        "        print(f\"   ℹ️  Capacidad total PDF: {b['capacity_ah']} Ah \"\n",
        "              f\"(no se pudo calcular por pack — verificar número de baterías)\")\n",
        "\n",
        "    # ─── MPPTs ────────────────────────────────────────────────────────────────\n",
        "    ok_m, line = _compare(\"MPPTs (controladores)\", iv[\"total_mppt\"], inv_mppTs)\n",
        "    print(line)\n",
        "    if ok_m is False:\n",
        "        issues.append((\"error\", f\"MPPTs: ingresado={inv_mppTs} vs PDF={iv['total_mppt']}\"))\n",
        "\n",
        "    # ─── SOC mínimo ───────────────────────────────────────────────────────────\n",
        "    ok_s, line = _compare(\"SOC mínimo de descarga (%)\", b[\"soc_min_pct\"],\n",
        "                           inv_soc_min, tol=TOL_SOC, unit=\"%\",\n",
        "                           from_variant=b.get(\"_from_variant\", False))\n",
        "    print(line)\n",
        "    if ok_s is False:\n",
        "        issues.append((\"error\",\n",
        "            f\"SOC mínimo: ingresado={inv_soc_min}% vs PDF={b['soc_min_pct']}%\"))\n",
        "\n",
        "    # ─── Coherencia kWp / kW_carga ────────────────────────────────────────────\n",
        "    #if p[\"total_kwp\"] and ld[\"average_kw\"]:\n",
        "       # ratio = p[\"total_kwp\"] / ld[\"average_kw\"]\n",
        "       # print(f\"\\n   ℹ️  kWp / kW_carga = {p['total_kwp']:.2f} / \"\n",
        "              #f\"{ld['average_kw']:.2f} = {ratio:.2f}×  \"\n",
        "             # f\"[{'OK' if ratio >= 1.0 else 'BAJO — posible subdimensionamiento'}]\")\n",
        "        #if ratio < 1.0:\n",
        "            #issues.append((\"warning\",\n",
        "                #f\"Relación kWp/kW_carga = {ratio:.2f}× < 1.0 → subdimensionamiento\"))\n",
        "\n",
        "    inv_ok = all(r is True for r in [ok_p, ok_b, ok_m, ok_s] if r is not None)\n",
        "    print(f\"\\n  → Inventario: \"\n",
        "          f\"{'TODOS LOS VALORES COINCIDEN CON EL PDF ✓' if inv_ok else 'DISCREPANCIAS DETECTADAS'}\")\n",
        "\n",
        "    # ══════════════════════════════════════════════════════════════════════════\n",
        "    # PUNTO 2 — ANÁLISIS DE PÉRDIDAS REGIONALES\n",
        "    # ══════════════════════════════════════════════════════════════════════════\n",
        "    print(\"\\n\" + \"═\" * 68)\n",
        "    print(\"  PUNTO 2: ANÁLISIS DE PÉRDIDAS REGIONALES\")\n",
        "    print(\"═\" * 68)\n",
        "\n",
        "    caribe  = _is_caribbean(site)\n",
        "    soil    = lo[\"soiling_pct\"]\n",
        "    temp_pv = lo[\"temp_pv_pct\"]\n",
        "\n",
        "    print(f\"   Sitio   : {site.get('name') or '—'}  │  País: {site.get('country') or '—'}\")\n",
        "    print(f\"   Zona Jamaica/Barbados: {'SÍ 🏝️' if caribe else 'No'}\")\n",
        "    print(\"\")\n",
        "\n",
        "    if soil is not None:\n",
        "        print(f\"   🪣  Soiling loss factor (PVsyst): {soil:.2f} %\")\n",
        "        if caribe and soil < SOIL_MIN_JAM:\n",
        "            print(\n",
        "                f\"\\n   🚨 ALERTA — SOILING INSUFICIENTE EN ZONA CARIBE:\\n\"\n",
        "                f\"      Sitio en {site.get('country','Jamaica/Barbados')} — \"\n",
        "                f\"clima tropical con humedad salina,\\n\"\n",
        "                f\"      polvo costero y contaminación biológica (musgo/algas).\\n\"\n",
        "                f\"      Soiling loss factor de {soil:.1f}% SUBESTIMA la degradación real.\\n\"\n",
        "                f\"      → Recomendación: usar mínimo {SOIL_MIN_JAM:.0f}% \"\n",
        "                f\"o documentar plan de limpieza con\\n\"\n",
        "                f\"        frecuencia justificada para el valor configurado.\"\n",
        "            )\n",
        "            issues.append((\"error\",\n",
        "                f\"ALERTA CARIBE: soiling factor {soil:.1f}% < {SOIL_MIN_JAM:.0f}% mínimo \"\n",
        "                f\"para {site.get('country','Jamaica/Barbados')}\"))\n",
        "        elif soil > SOIL_MAX:\n",
        "            print(f\"   ⚠️  Soiling muy alto ({soil:.1f}% > {SOIL_MAX:.0f}%). \"\n",
        "                  f\"Verificar mantenimiento y frecuencia de limpieza.\")\n",
        "            issues.append((\"warning\", f\"Soiling factor elevado: {soil:.1f}%\"))\n",
        "        else:\n",
        "            print(f\"   ✅ Soiling loss factor {soil:.1f}% dentro de rango esperado.\")\n",
        "            if caribe:\n",
        "                print(f\"      (Zona Caribe: OK ≥ {SOIL_MIN_JAM:.0f}%)\")\n",
        "    else:\n",
        "        print(\"   ⚠️  Soiling loss factor no encontrado en el PDF.\")\n",
        "        issues.append((\"warning\", \"Soiling loss factor no extraído del PDF.\"))\n",
        "\n",
        "    print(\"\")\n",
        "    if temp_pv is not None:\n",
        "        print(f\"   🌡️  PV loss due to temperature: {temp_pv:.2f} %  (referencia)\")\n",
        "        if temp_pv > 8:\n",
        "            print(\"   ⚠️  Pérdidas térmicas PV >8%. Revisar coeficiente Tc y ventilación.\")\n",
        "            issues.append((\"warning\", f\"Pérdidas temperatura PV altas: {temp_pv:.2f}%\"))\n",
        "        elif temp_pv >= 4:\n",
        "            print(\"   ℹ️  Pérdidas térmicas PV moderadas (4–8%) — típico de clima tropical.\")\n",
        "        else:\n",
        "            print(\"   ✅ Pérdidas térmicas PV dentro del rango normal (<4%).\")\n",
        "    else:\n",
        "        print(\"   ℹ️  PV loss due to temperature: no disponible en PDF.\")\n",
        "\n",
        "    # ══════════════════════════════════════════════════════════════════════════\n",
        "    # PUNTO 3 — COMPORTAMIENTO DE BATERÍA\n",
        "    # ══════════════════════════════════════════════════════════════════════════\n",
        "    print(\"\\n\" + \"═\" * 68)\n",
        "    print(\"  PUNTO 3: COMPORTAMIENTO DE BATERÍA\")\n",
        "    print(\"═\" * 68)\n",
        "\n",
        "    bt_temp    = bt[\"design_temp_c\"]\n",
        "    e_miss     = e[\"e_miss\"]\n",
        "    e_user     = e[\"e_user\"]\n",
        "    sol_frac   = e[\"sol_frac\"]\n",
        "    cycles     = e[\"cycles\"]\n",
        "    bat_life   = e[\"bat_life\"]\n",
        "    annual_kwh = ld[\"annual_kwh\"]\n",
        "\n",
        "    print(\"\")\n",
        "    if bt_temp is not None:\n",
        "        print(f\"   🌡️  Temperatura de diseño del banco (PVsyst): {bt_temp:.0f} °C  \"\n",
        "              f\"(modelo: temperatura fija)\")\n",
        "        print(f\"   🌡️  Temperatura ambiente esperada (usuario): {inv_temp_amb:.1f} °C\")\n",
        "        HEAT_MARGIN = 7.0\n",
        "        op_temp_est = inv_temp_amb + HEAT_MARGIN\n",
        "        print(f\"   ℹ️  Temperatura operación estimada (amb+{HEAT_MARGIN:.0f}°C): \"\n",
        "              f\"{op_temp_est:.1f} °C\")\n",
        "        if op_temp_est > BATT_MAX_TEMP:\n",
        "            print(\n",
        "                f\"\\n   ❌ RIESGO TÉRMICO EN BANCO DE BATERÍAS:\\n\"\n",
        "                f\"      La temperatura estimada de operación ({op_temp_est:.1f}°C) supera\\n\"\n",
        "                f\"      el límite recomendado para LFP ({BATT_MAX_TEMP:.0f}°C).\\n\"\n",
        "                f\"      → Revisar ventilación del enclosure, sombra y sistema de\\n\"\n",
        "                f\"        gestión térmica del banco.\"\n",
        "            )\n",
        "            issues.append((\"error\",\n",
        "                f\"Riesgo térmico: op. estimada {op_temp_est:.1f}°C > máx. LFP {BATT_MAX_TEMP:.0f}°C\"))\n",
        "        elif abs(op_temp_est - bt_temp) > TEMP_MARGIN:\n",
        "            print(\n",
        "                f\"   ⚠️  La temperatura de diseño en PVsyst ({bt_temp:.0f}°C) difiere\\n\"\n",
        "                f\"      {abs(op_temp_est - bt_temp):.1f}°C de la estimación de campo ({op_temp_est:.1f}°C).\\n\"\n",
        "                f\"      Verificar que el modelo térmico del banco refleje las condiciones reales.\"\n",
        "            )\n",
        "            issues.append((\"warning\",\n",
        "                f\"Temperatura de diseño PVsyst ({bt_temp:.0f}°C) vs estimación campo \"\n",
        "                f\"({op_temp_est:.1f}°C) — diferencia de {abs(op_temp_est-bt_temp):.1f}°C\"))\n",
        "        else:\n",
        "            print(f\"   ✅ Temperatura de diseño ({bt_temp:.0f}°C) coherente \"\n",
        "                  f\"con condiciones de campo estimadas ({op_temp_est:.1f}°C).\")\n",
        "    else:\n",
        "        print(\"   ⚠️  Temperatura de diseño del banco: no encontrada en PDF.\")\n",
        "        issues.append((\"warning\", \"Temperatura de diseño del banco no extraída del PDF.\"))\n",
        "\n",
        "    print(\"\")\n",
        "    if b[\"soc_min_pct\"] is not None:\n",
        "        print(f\"   🔋 SOC mínimo configurado: {b['soc_min_pct']:.1f}%\")\n",
        "        if b[\"soc_min_pct\"] < 15:\n",
        "            print(f\"   ⚠️  SOC mínimo bajo ({b['soc_min_pct']:.0f}%). \"\n",
        "                  f\"Para LFP se recomienda ≥15–20% para proteger la vida útil.\")\n",
        "            issues.append((\"warning\",\n",
        "                f\"SOC mínimo {b['soc_min_pct']:.0f}% puede reducir vida útil de batería LFP\"))\n",
        "        else:\n",
        "            print(f\"   ✅ SOC mínimo {b['soc_min_pct']:.0f}% adecuado para LFP.\")\n",
        "\n",
        "    if cycles is not None:\n",
        "        print(f\"   🔄 Ciclos simulados (SOW): {cycles:.1f}\")\n",
        "    if bat_life is not None:\n",
        "        print(f\"   📅 Vida útil estimada: {bat_life:.1f} años\")\n",
        "        if bat_life < 5:\n",
        "            print(f\"   ⚠️  Vida útil baja ({bat_life:.1f} años). \"\n",
        "                  f\"Revisar profundidad de descarga y temperatura de operación.\")\n",
        "            issues.append((\"warning\",\n",
        "                f\"Vida útil de batería estimada solo {bat_life:.1f} años\"))\n",
        "\n",
        "    # ─── Déficit energético (E_Miss) — solo informativo ───────────────────────\n",
        "    print(\"\")\n",
        "    if e_miss is not None and annual_kwh:\n",
        "        miss_pct = (e_miss / annual_kwh) * 100\n",
        "        print(f\"   ⚡ Energía faltante (E_Miss):     {e_miss:,.0f} kWh/año  \"\n",
        "              f\"({miss_pct:.1f}% de la carga total)\")\n",
        "        if e_user is not None:\n",
        "            print(f\"   ☀️  Energía solar suministrada:   {e_user:,.0f} kWh/año\")\n",
        "        if sol_frac is not None:\n",
        "            print(f\"   ☀️  Fracción solar (Solar Fraction): {sol_frac*100:.1f}%\"\n",
        "                  if sol_frac < 1 else f\"   ☀️  Fracción solar: {sol_frac:.1f}%\")\n",
        "        if miss_pct >= MISS_ERROR:\n",
        "            print(\n",
        "                f\"\\n   ℹ️  NOTA — DÉFICIT ENERGÉTICO ALTO ({miss_pct:.1f}% de la carga):\\n\"\n",
        "                f\"      El sistema solar+batería no cubre {miss_pct:.1f}% de la demanda\\n\"\n",
        "                f\"      anual ({e_miss:,.0f} kWh/año). Revisar si el generador de respaldo\\n\"\n",
        "                f\"      cubre la brecha, o considerar ampliar el sistema.\"\n",
        "            )\n",
        "        elif miss_pct >= MISS_WARN:\n",
        "            print(f\"   ℹ️  Déficit energético moderado ({miss_pct:.1f}%). \"\n",
        "                  f\"Verificar cobertura del generador de respaldo.\")\n",
        "        else:\n",
        "            print(f\"   ✅ Déficit energético bajo ({miss_pct:.1f}%). \"\n",
        "                  f\"El sistema cubre la mayor parte de la carga.\")\n",
        "    else:\n",
        "        print(\"   ℹ️  E_Miss no disponible en PDF. \"\n",
        "              \"Revisar tabla de resultados manualmente.\")\n",
        "\n",
        "    # ══════════════════════════════════════════════════════════════════════════\n",
        "    # RESUMEN FINAL Y VEREDICTO\n",
        "    # ══════════════════════════════════════════════════════════════════════════\n",
        "    errors   = [m for s_, m in issues if s_ == \"error\"]\n",
        "    warnings = [m for s_, m in issues if s_ == \"warning\"]\n",
        "\n",
        "    print(\"\\n\" + \"═\" * W)\n",
        "    print(\"  RESUMEN DE INCIDENCIAS\")\n",
        "    print(\"═\" * W)\n",
        "\n",
        "    if errors:\n",
        "        print(f\"\\n  ❌ ERRORES CRÍTICOS ({len(errors)}):\")\n",
        "        for i, err in enumerate(errors, 1):\n",
        "            words = err.split()\n",
        "            line  = f\"     {i}. \"\n",
        "            for w in words:\n",
        "                if len(line) + len(w) + 1 > W + 2:\n",
        "                    print(line); line = \"        \" + w + \" \"\n",
        "                else:\n",
        "                    line += w + \" \"\n",
        "            print(line)\n",
        "\n",
        "    if warnings:\n",
        "        print(f\"\\n  ⚠️  ADVERTENCIAS ({len(warnings)}):\")\n",
        "        for i, w in enumerate(warnings, 1):\n",
        "            print(f\"     {i}. {w}\")\n",
        "\n",
        "    print(\"\\n\" + \"╔\" + \"═\" * W + \"╗\")\n",
        "    if errors:\n",
        "        print(\"║\" + \"\".center(W) + \"║\")\n",
        "        print(\"║\" + \"  ❌  RECHAZADO PARA CORRECCIÓN  \".center(W) + \"║\")\n",
        "        print(\"║\" + \"\".center(W) + \"║\")\n",
        "        print(\"╠\" + \"═\" * W + \"╣\")\n",
        "        print(\"║\" + \"  Motivos:\".ljust(W) + \"║\")\n",
        "        for i, err in enumerate(errors, 1):\n",
        "            chunk = f\"  {i}. {err[:62]}\"\n",
        "            print(\"║\" + chunk.ljust(W) + \"║\")\n",
        "            if len(err) > 62:\n",
        "                chunk2 = f\"     {err[62:125]}\"\n",
        "                print(\"║\" + chunk2.ljust(W) + \"║\")\n",
        "    else:\n",
        "        note = f\" — revisar {len(warnings)} advert.\" if warnings else \"\"\n",
        "        print(\"║\" + \"\".center(W) + \"║\")\n",
        "        print(\"║\" + f\"  ✅  APROBADO PARA CONSTRUCCIÓN{note}  \".center(W) + \"║\")\n",
        "        print(\"║\" + \"\".center(W) + \"║\")\n",
        "        print(\"╠\" + \"═\" * W + \"╣\")\n",
        "        msg = (\"  No se detectaron errores críticos. El diseño es consistente\\n\"\n",
        "               \"  con el archivo PVsyst. Revisar advertencias antes de proceder.\")\n",
        "        for ln in msg.split(\"\\n\"):\n",
        "            print(\"║\" + ln.ljust(W) + \"║\")\n",
        "\n",
        "    print(\"╚\" + \"═\" * W + \"╝\")\n",
        "    print(f\"\\n  {len(errors)} error(es) crítico(s)  │  {len(warnings)} advertencia(s)\")\n",
        "    print(\"═\" * W)\n",
        "    return errors, warnings\n",
