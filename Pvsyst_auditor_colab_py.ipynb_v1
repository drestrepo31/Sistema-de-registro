      "source": [
        "# ================================================================\n",
        "# PVSYST PDF AUDIT TOOL — Google Colab\n",
        "# Validado contra PVsyst V8.0.21 (etiquetas extraídas del PDF real)\n",
        "# ================================================================\n",
        "\n",
        "\n",
        "# ================================================================"
      ],
      "metadata": {
        "id": "vVcCpzZ8v2dw"
      },
