      "source": [
        "# ================================================================\n",
        "# CELDA 3 — Cargar PDF y confirmar variante\n",
        "# ================================================================\n",
        "# @title 📂 Cargar reporte PDF de PVsyst\n",
        "\n",
        "print(\"=\" * 65)\n",
        "print(\"  Sube el reporte PDF exportado desde PVsyst\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "uploaded = files.upload()\n",
        "if not uploaded:\n",
        "    raise SystemExit(\"❌ No se cargó ningún archivo.\")\n",
        "\n",
        "filename  = list(uploaded.keys())[0]\n",
        "pdf_bytes = uploaded[filename]\n",
        "\n",
        "print(f\"\\n📄  {filename}  ({len(pdf_bytes):,} bytes)\\nExtrayendo texto…\")\n",
        "\n",
        "parser = PVsystPDFParser(pdf_bytes)\n",
        "\n",
        "texto_total = len(parser.full_text.strip())\n",
        "print(f\"📝 Texto extraído del PDF: {texto_total:,} caracteres  \"\n",
        "      f\"({'OK' if texto_total > 500 else '⚠️  MUY POCO — puede fallar la extracción'})\")\n",
        "if texto_total < 300:\n",
        "    print(\"\\n  Primeros 400 chars del texto extraído (para depuración):\")\n",
        "    print(\"  \" + repr(parser.full_text[:400]))\n",
        "print()\n",
        "parser.show_summary()\n",
        "\n",
        "variant_name = parser.data[\"variant\"][\"name\"] or \"VC1\"\n",
        "print(f\"\\n✅ Variante detectada: {variant_name}\")\n",
        "override = input(\"  Presiona ENTER para continuar, \"\n",
        "                 \"o escribe el nombre correcto de variante: \").strip()\n",
        "if override:\n",
        "    variant_name = override"
      ],
