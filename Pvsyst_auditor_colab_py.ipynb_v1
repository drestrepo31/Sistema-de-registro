      ],
      "source": [
        "# @title ⚙️ Instalación\n",
        "import subprocess\n",
        "for pkg in [\"pdfplumber\", \"pypdf\"]:\n",
        "    subprocess.run([\"pip\", \"install\", pkg, \"--quiet\"], capture_output=True)\n",
        "\n",
        "print(\"✅ pdfplumber y pypdf instalados\")\n",
        "\n",
        "\n",
        "# ================================================================"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# @title 🔧 Clase PVsystPDFParser (v3)\n",
        "\n",
        "import pdfplumber\n",
        "import re\n",
        "import io\n",
        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "from google.colab import files\n",
        "from IPython.display import display, HTML, clear_output\n",
        "\n",
        "\n",
        "# ─── Utilidades ──────────────────────────────────────────────────────────────\n",
        "\n",
        "def _f(s):\n",
        "    \"\"\"Convierte string a float de forma segura.\"\"\"\n",
        "    if s is None:\n",
        "        return None\n",
        "    try:\n",
        "        return float(str(s).strip().replace(',', '').replace(' ', ''))\n",
        "    except (ValueError, TypeError):\n",
        "        return None\n",
        "\n",
        "\n",
        "def _pct(val):\n",
        "    \"\"\"Si el valor es fracción (≤1), lo convierte a porcentaje.\"\"\"\n",
        "    v = _f(val)\n",
        "    if v is None:\n",
        "        return None\n",
        "    return round(v * 100, 2) if v <= 1.0 else round(abs(v), 2)\n",
        "\n",
        "\n",
        "def _first(patterns, text, flags=re.IGNORECASE | re.DOTALL):\n",
        "    \"\"\"Devuelve el primer grupo capturado no-nulo del primer patrón que haga match.\"\"\"\n",
        "    for p in patterns:\n",
        "        m = re.search(p, text, flags)\n",
        "        if m:\n",
        "            for g in m.groups():\n",
        "                if g is not None:\n",
        "                    return g.strip()\n",
        "    return None\n",
        "\n",
        "\n",
        "def _first_num_in_range(text, lo, hi):\n",
        "    \"\"\"Devuelve el primer número en el rango [lo, hi] encontrado en text.\"\"\"\n",
        "    for tok in re.findall(r'-?\\d+(?:\\.\\d+)?', text):\n",
        "        v = _f(tok)\n",
        "        if v is not None and lo <= v <= hi:\n",
        "            return v\n",
        "    return None\n",
        "\n",
        "\n",
        "# ─── Clase principal ─────────────────────────────────────────────────────────\n",
        "\n",
        "class PVsystPDFParser:\n",
        "    \"\"\"\n",
        "    Extrae parámetros de un reporte PDF generado por PVsyst 7.x / 8.x.\n",
        "    Etiquetas exactas validadas contra PVsyst V8.0.21 (idioma inglés).\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, pdf_bytes: bytes):\n",
        "        self.pdf_bytes   = pdf_bytes\n",
        "        self.pages_text  = []\n",
        "        self.full_text   = \"\"\n",
        "        self.data        = {}\n",
        "        self._extract_text()\n",
        "        self._parse_all()\n",
        "\n",
        "    def _extract_text(self):\n",
        "        with pdfplumber.open(io.BytesIO(self.pdf_bytes)) as pdf:\n",
        "            for page in pdf.pages:\n",
        "                raw = \"\"\n",
        "                try:\n",
        "                    raw = page.extract_text(x_tolerance=3, y_tolerance=4) or \"\"\n",
        "                except Exception:\n",
        "                    pass\n",
        "                if len(raw.strip()) < 120:\n",
        "                    try:\n",
        "                        raw2 = page.extract_text(x_tolerance=6, y_tolerance=6) or \"\"\n",
        "                        if len(raw2.strip()) > len(raw.strip()):\n",
        "                            raw = raw2\n",
        "                    except Exception:\n",
        "                        pass\n",
        "                if len(raw.strip()) < 120:\n",
        "                    try:\n",
        "                        raw3 = page.extract_text(x_tolerance=10, y_tolerance=8) or \"\"\n",
        "                        if len(raw3.strip()) > len(raw.strip()):\n",
        "                            raw = raw3\n",
        "                    except Exception:\n",
        "                        pass\n",
        "                if len(raw.strip()) < 120:\n",
        "                    try:\n",
        "                        words = page.extract_words(\n",
        "                            x_tolerance=4, y_tolerance=4,\n",
        "                            keep_blank_chars=False, use_text_flow=False)\n",
        "                        if words:\n",
        "                            words_sorted = sorted(\n",
        "                                words,\n",
        "                                key=lambda w: (round(float(w['top']) / 6) * 6,\n",
        "                                               float(w['x0'])))\n",
        "                            raw_w = \"  \".join(w['text'] for w in words_sorted)\n",
        "                            if len(raw_w.strip()) > len(raw.strip()):\n",
        "                                raw = raw_w\n",
        "                    except Exception:\n",
        "                        pass\n",
        "                self.pages_text.append(raw)\n",
        "        self.full_text = \"\\n\".join(self.pages_text)\n",
        "\n",
        "    def _section(self, header_re, end_re=None, n_lines=60):\n",
        "        m = re.search(header_re, self.full_text, re.IGNORECASE | re.DOTALL)\n",
        "        if not m:\n",
        "            return self.full_text\n",
        "        start = m.start()\n",
        "        chunk = self.full_text[start:]\n",
        "        if end_re:\n",
        "            e = re.search(end_re, chunk[len(m.group()):], re.IGNORECASE)\n",
        "            if e:\n",
        "                chunk = chunk[:len(m.group()) + e.start()]\n",
        "        return \"\\n\".join(chunk.split(\"\\n\")[:n_lines])\n",
        "\n",
        "    def _parse_from_variant(self, variant_str=None):\n",
        "        \"\"\"\n",
        "        Extrae valores clave del nombre de variante PVsyst.\n",
        "        Formato: \"30@625_4pk_10%SOC_bkup0h_5.00kWavg IDEAL V0\"\n",
        "        \"\"\"\n",
        "        s = variant_str or (self.data.get(\"variant\", {}) or {}).get(\"name\", \"\") or \"\"\n",
        "        result = {}\n",
        "        if not s:\n",
        "            return result\n",
        "        m = re.search(r'(\\d+)\\s*@\\s*(\\d+)', s)\n",
        "        if m:\n",
        "            result['panels_count'] = int(m.group(1))\n",
        "            result['panel_wp']     = int(m.group(2))\n",
        "        m = re.search(r'(\\d+)\\s*pk\\b', s, re.IGNORECASE)\n",
        "        if m:\n",
        "            result['batt_count'] = int(m.group(1))\n",
        "        m = re.search(r'(\\d+(?:\\.\\d+)?)\\s*%\\s*SOC\\b', s, re.IGNORECASE)\n",
        "        if m:\n",
        "            result['soc_min'] = float(m.group(1))\n",
        "        m = re.search(r'(\\d+(?:\\.\\d+)?)\\s*kWavg\\b', s, re.IGNORECASE)\n",
        "        if m:\n",
        "            result['avg_kw'] = float(m.group(1))\n",
        "        return result\n",
        "\n",
        "    def _apply_variant_fallbacks(self):\n",
        "        \"\"\"\n",
        "        Usa el nombre de variante como respaldo para campos None.\n",
        "        Nunca sobreescribe valores ya extraídos del PDF.\n",
        "        \"\"\"\n",
        "        vf = self._parse_from_variant()\n",
        "        if not vf:\n",
        "            return\n",
        "        p  = self.data[\"panels\"]\n",
        "        b  = self.data[\"batteries\"]\n",
        "        ld = self.data[\"load\"]\n",
        "\n",
        "        if vf.get('panels_count') is not None and p[\"count\"] is None:\n",
        "            p[\"count\"] = vf['panels_count'];  p[\"_from_variant\"] = True\n",
        "        if vf.get('panel_wp') is not None and p[\"power_wp\"] is None:\n",
        "            p[\"power_wp\"] = vf['panel_wp'];   p[\"_from_variant\"] = True\n",
        "        if p[\"count\"] and p[\"power_wp\"] and p[\"total_kwp\"] is None:\n",
        "            p[\"total_kwp\"] = round(p[\"count\"] * p[\"power_wp\"] / 1000, 3)\n",
        "        if vf.get('batt_count') is not None and b[\"count\"] is None:\n",
        "            b[\"count\"] = vf['batt_count'];    b[\"_from_variant\"] = True\n",
        "        if vf.get('soc_min') is not None and b[\"soc_min_pct\"] is None:\n",
        "            b[\"soc_min_pct\"] = vf['soc_min']; b[\"_from_variant\"] = True\n",
        "\n",
        "        # Carga: kWavg variante → annual_kwh → avg_kw = annual_kwh/8760\n",
        "        # Nunca se asigna avg_kw directamente; siempre pasa por la división.\n",
        "        if vf.get('avg_kw') is not None and ld[\"annual_kwh\"] is None:\n",
        "            ld[\"annual_kwh\"] = round(vf['avg_kw'] * 8760)\n",
        "            ld[\"_from_variant\"] = True\n",
        "        if ld[\"annual_kwh\"] is not None and ld[\"average_kw\"] is None:\n",
        "            ld[\"average_kw\"] = round(ld[\"annual_kwh\"] / 8760, 3)\n",
        "\n",
        "    def _parse_all(self):\n",
        "        t = self.full_text\n",
        "        self.data = {\n",
        "            \"project\":      self._project(t),\n",
        "            \"variant\":      self._variant(t),\n",
        "            \"site\":         self._site(t),\n",
        "            \"panels\":       self._panels(t),\n",
        "            \"batteries\":    self._batteries(t),\n",
        "            \"inverter\":     self._inverter(t),\n",
        "            \"losses\":       self._losses(t),\n",
        "            \"load\":         self._load(t),\n",
        "            \"energy\":       self._energy(t),\n",
        "            \"battery_temp\": self._battery_temp(t),\n",
        "        }\n",
        "        self._apply_variant_fallbacks()\n",
        "\n",
        "    def _project(self, t):\n",
        "        name = _first([r\"Project:\\s*(.+)\", r\"Projet\\s*:\\s*(.+)\", r\"Proyecto\\s*:\\s*(.+)\"], t)\n",
        "        return {\"name\": name}\n",
        "\n",
        "    def _variant(self, t):\n",
        "        name = _first([r\"Variant:\\s*(.+)\", r\"Variante\\s*:\\s*(.+)\"], t)\n",
        "        return {\"name\": name}\n",
        "\n",
        "    def _site(self, t):\n",
        "        country = _first([\n",
        "            r\"\\b(Jamaica|Barbados|Trinidad|Colombia|Panama|Guyana|Belize|Honduras|Guatemala)\\b\",\n",
        "            r\"Country\\s*[:\\-–]\\s*([^\\n]+)\",\n",
        "            r\"Pa[ií]s\\s*[:\\-–]\\s*([^\\n]+)\",\n",
        "        ], t)\n",
        "        site = _first([r\"Project:\\s*(.+?)\\s*(?:\\n|$)\", r\"Site\\s*[:\\-–]\\s*([^\\n]+)\"], t)\n",
        "        lat  = _f(_first([r\"Latitude\\s+(-?\\d+\\.\\d+)\"], t))\n",
        "        return {\"name\": site, \"country\": country, \"latitude\": lat}\n",
        "\n",
        "    def _panels(self, t):\n",
        "        batt_sec = self._section(r\"PV\\s+Array\\s+Characteristics\",\n",
        "                                  r\"Battery\\s+(?:Storage|pack|Management)\")\n",
        "        n_tot = _f(_first([\n",
        "            r\"Number\\s+of\\s+PV\\s+modules\\s+Modules\\s+(\\d+)\",\n",
        "            r\"Number\\s+of\\s+PV\\s+modules\\s+(\\d+)\",\n",
        "            r\"Nb\\.\\s+of\\s+modules\\s+Pnom\\s+total\\s+(\\d+)\",\n",
        "            r\"Nb\\.\\s+of\\s+modules\\s+(\\d+)\",\n",
        "            r\"(\\d+)\\s+string\\s+x\\s+(\\d+)\",\n",
        "        ], batt_sec))\n",
        "        if n_tot is None:\n",
        "            m = re.search(r\"(\\d+)\\s+string\\s+x\\s+(\\d+)\", batt_sec, re.IGNORECASE)\n",
        "            if m:\n",
        "                n_tot = int(m.group(1)) * int(m.group(2))\n",
        "        p_wp = _f(_first([\n",
        "            r\"Unit\\s+Nom\\.\\s+Power\\s+(\\d+)\\s+Wp\",\n",
        "            r\"Pnom\\s*\\(unit(?:ary)?\\)\\s+(\\d+)\\s+Wp\",\n",
        "            r\"Nominal\\s+power\\s+(\\d+)\\s+Wp\",\n",
        "            r\"\\b(\\d{3,4})\\s+Wp\\b\",\n",
        "        ], batt_sec))\n",
        "        kwp = _f(_first([\n",
        "            r\"Pnom\\s+total\\s+(\\d+\\.\\d+)\\s+kWp\",\n",
        "            r\"System\\s+power:\\s+(\\d+\\.\\d+)\\s+kWp\",\n",
        "            r\"(\\d+\\.\\d+)\\s+kWp\",\n",
        "        ], t))\n",
        "        model  = _first([\n",
        "            r\"(?:JA\\s+Solar|Trina|Canadian\\s+Solar|Longi|SunPower|Jinko|REC|Q\\s+CELLS?)[^\\n]{0,60}\",\n",
        "            r\"PV\\s+module\\s+[:\\-]?\\s*([A-Z][^\\n]{4,60})\",\n",
        "        ], batt_sec)\n",
        "        n_ser  = _f(_first([r\"In\\s+series\\s+(\\d+)\", r\"(\\d+)\\s+string\"], batt_sec))\n",
        "        n_par  = _f(_first([r\"in\\s+parallel\\s+(\\d+)\", r\"(\\d+)\\s+parallel\"], batt_sec))\n",
        "        computed = (int(n_tot) * p_wp / 1000) if (n_tot and p_wp) else None\n",
        "        return {\n",
        "            \"count\":      int(n_tot) if n_tot else None,\n",
        "            \"n_series\":   int(n_ser) if n_ser else None,\n",
        "            \"n_parallel\": int(n_par) if n_par else None,\n",
        "            \"power_wp\":   p_wp,\n",
        "            \"total_kwp\":  kwp or computed,\n",
        "            \"model\":      model,\n",
        "        }\n",
        "\n",
        "    def _batteries(self, t):\n",
        "        \"\"\"\n",
        "        \"Nb. of units\" (con \"of\") = baterías\n",
        "        \"Nb. units\"    (sin \"of\") = MPPT\n",
        "        \"\"\"\n",
        "        bsec = self._section(r\"Battery\\s+Storage\",\n",
        "                              r\"(?:Page\\s+\\d|Controller|MPPT|PV\\s+Array|Converter)\", n_lines=80)\n",
        "        count = None\n",
        "        m_bat = re.search(\n",
        "            r\"Nb\\.\\s+of\\s+units[^\\d]{0,200}?(\\d+)\\s*(?:in\\s+parallel|units)\",\n",
        "            bsec, re.IGNORECASE | re.DOTALL)\n",
        "        if m_bat:\n",
        "            count = int(m_bat.group(1))\n",
        "        else:\n",
        "            raw = _first([r\"Nb\\.\\s+of\\s+units[^\\d]{0,100}(\\d+)\"], bsec)\n",
        "            count = int(_f(raw)) if raw else None\n",
        "\n",
        "        soc_min = None\n",
        "        m_soc = re.search(r\"Discharging\\s+min\\.\\s+SOC\", bsec, re.IGNORECASE)\n",
        "        if m_soc:\n",
        "            window = bsec[m_soc.end():m_soc.end()+300]\n",
        "            soc_min = _first_num_in_range(window, 5.0, 50.0)\n",
        "        if soc_min is None:\n",
        "            raw = _first([r\"(?:Minimum\\s+SOC|SOC\\s+min(?:imum)?|SOCmin)\\s*[:\\s]+(\\d+(?:\\.\\d+)?)\"], t)\n",
        "            soc_min = _pct(raw)\n",
        "\n",
        "        cap_ah = None\n",
        "        m_cap = re.search(r\"Nominal\\s+Capacity\", bsec, re.IGNORECASE)\n",
        "        if m_cap:\n",
        "            window = bsec[m_cap.end():m_cap.end()+300]\n",
        "            for tok in re.findall(r'\\d+(?:\\.\\d+)?', window):\n",
        "                v = _f(tok)\n",
        "                if v is not None and v >= 100:\n",
        "                    cap_ah = v\n",
        "                    break\n",
        "        if cap_ah is None:\n",
        "            raw = _first([r\"Capacity\\s*\\(?bat\\.?\\)?\\s*[:\\s]+(\\d+(?:\\.\\d+)?)\\s*Ah\",\n",
        "                          r\"Capacit[eé]\\s*\\(?bat\\.?\\)?\\s*[:\\s]+(\\d+(?:\\.\\d+)?)\\s*Ah\"], t)\n",
        "            cap_ah = _f(raw)\n",
        "\n",
        "        model = _first([\n",
        "            r\"(?:Shoto|BYD|CATL|SimpliPhi|Pylontech|Electriq|Freedomwon)[^\\n]{0,60}\",\n",
        "            r\"(?:Battery|Bater[ií]a)\\s+[:\\-]?\\s*([^\\n]{4,60})\",\n",
        "        ], bsec)\n",
        "        return {\"count\": count, \"capacity_ah\": cap_ah, \"soc_min_pct\": soc_min, \"model\": model}\n",
        "\n",
        "    def _battery_temp(self, t):\n",
        "        bsec = self._section(r\"Battery\\s+Pack\\s+Characteristics\",\n",
        "                              r\"(?:Page\\s+\\d|Controller|Results)\", n_lines=20)\n",
        "        temp = _f(_first([r\"Fixed\\s+(\\d+(?:\\.\\d+)?)\\s*(?:V|°|Ah|in\\s+parallel|$|\\n)\"], bsec))\n",
        "        if temp is None:\n",
        "            m = re.search(r\"Temperature[^\\d]{0,100}\", bsec, re.IGNORECASE)\n",
        "            if m:\n",
        "                window = bsec[m.end():m.end()+100]\n",
        "                temp = _first_num_in_range(window, 0.0, 80.0)\n",
        "        if temp is None:\n",
        "            temp = _f(_first([\n",
        "                r\"Battery\\s+[Tt]emp(?:erature)?\\s*[:\\s]+(\\d+(?:\\.\\d+)?)\\s*[°]?C\",\n",
        "                r\"Operating\\s+[Tt]emp\\s*[:\\s]+(\\d+(?:\\.\\d+)?)\",\n",
        "            ], t))\n",
        "        return {\"design_temp_c\": temp}\n",
        "\n",
        "    def _inverter(self, t):\n",
        "        \"\"\"\n",
        "        \"Nb. units\" (SIN \"of\") = cantidad de controladores MPPT\n",
        "        \"\"\"\n",
        "        csec = self._section(r\"(?:Controller|MPPT\\s+converter|Charge\\s+controller)\",\n",
        "                              r\"(?:Battery\\s+(?:Storage|Management)|Page\\s+\\d)\", n_lines=30)\n",
        "        mppt_count = None\n",
        "        m_mppt = re.search(\n",
        "            r\"Nb\\.\\s*units[^\\d]{0,150}?(\\d+)\\s*(?:MPPT\\s+converter|units|Technology)\",\n",
        "            csec, re.IGNORECASE | re.DOTALL)\n",
        "        if m_mppt:\n",
        "            mppt_count = int(m_mppt.group(1))\n",
        "        else:\n",
        "            raw = _first([\n",
        "                r\"Nb\\.\\s*units[^\\d]{0,80}(\\d+)\",\n",
        "                r\"Number\\s+of\\s+(?:MPPT\\s+)?regulators?\\s+(\\d+)\",\n",
        "                r\"Nb\\.\\s+of\\s+(?:MPPT\\s+)?regulators?\\s+(\\d+)\",\n",
        "            ], csec)\n",
        "            mppt_count = int(_f(raw)) if raw else None\n",
        "        model = _first([\n",
        "            r\"(?:Eltek|Victron|Schneider|SMA|Huawei|Fronius|ABB|Sungrow|Growatt)[^\\n]{0,60}\",\n",
        "            r\"(?:Controller|Inverter|Inversor)\\s+[:\\-]?\\s*([^\\n]{4,60})\",\n",
        "        ], csec)\n",
        "        return {\"total_mppt\": mppt_count, \"model\": model}\n",
        "\n",
        "    def _losses(self, t):\n",
        "        soiling = None\n",
        "        m1 = re.search(r\"(-?\\d+\\.?\\d*)\\s*%[^\\n]{0,120}?Soiling\\s+loss\\s+factor\", t, re.IGNORECASE)\n",
        "        if m1:\n",
        "            soiling = abs(_f(m1.group(1)))\n",
        "        if soiling is None:\n",
        "            raw = _first([r\"Soiling\\s+loss\\s+factor[^\\n]{0,120}?(-?\\d+\\.?\\d*)\\s*%\"], t)\n",
        "            soiling = abs(_f(raw)) if raw else None\n",
        "        if soiling is None:\n",
        "            raw = _first([\n",
        "                r\"(?:Array\\s+)?Soiling[^\\n]{0,60}Loss\\s+Fraction[^\\n]{0,40}(\\d+\\.?\\d*)\",\n",
        "                r\"(?:Array\\s+)?Soiling\\s+Losses[^\\n]{0,40}(\\d+\\.?\\d*)\",\n",
        "            ], t)\n",
        "            soiling = abs(_f(raw)) if raw else None\n",
        "\n",
        "        temp_pv = None\n",
        "        m2 = re.search(r\"(-?\\d+\\.?\\d*)\\s*%[^\\n]{0,120}?PV\\s+loss\\s+due\\s+to\\s+temperature\",\n",
        "                        t, re.IGNORECASE)\n",
        "        if m2:\n",
        "            temp_pv = abs(_f(m2.group(1)))\n",
        "        if temp_pv is None:\n",
        "            raw = _first([\n",
        "                r\"PV\\s+loss\\s+due\\s+to\\s+temperature[^\\n]{0,120}?(-?\\d+\\.?\\d*)\\s*%\",\n",
        "                r\"Thermal\\s+Loss\\s+factor[^\\n]{0,40}(\\d+\\.?\\d*)\\s*W\",\n",
        "            ], t)\n",
        "            v = _f(raw)\n",
        "            temp_pv = v if (v is not None and v < 30) else None\n",
        "        return {\"soiling_pct\": soiling, \"temp_pv_pct\": temp_pv}\n",
        "\n",
        "    def _load(self, t):\n",
        "        \"\"\"\n",
        "        avg_kw = E_Load_year / 8760  — SIEMPRE.\n",
        "        Tabla PVsyst V8 fila Year:\n",
        "          GlobHor | GlobEff | E_Avail | EUnused | E_Miss | E_User | E_Load | SolFrac\n",
        "          E_Load = último entero grande antes de SolFrac (< 1.0)\n",
        "        \"\"\"\n",
        "        annual_kwh = None\n",
        "\n",
        "        # Estrategia 1: fila \"Year\" — último entero ≥ 1000 sin decimales\n",
        "        m_year = re.search(r\"\\bYear\\b(.{10,500})\", t, re.IGNORECASE | re.DOTALL)\n",
        "        if m_year:\n",
        "            row = m_year.group(1)[:500]\n",
        "            enteros = [_f(x) for x in re.findall(r'\\b(\\d{4,6})\\b', row)\n",
        "                       if _f(x) is not None and _f(x) >= 1000]\n",
        "            if enteros:\n",
        "                annual_kwh = enteros[-1]   # E_Load = última columna entera grande\n",
        "\n",
        "        # Estrategia 2: etiquetas E_Load\n",
        "        if annual_kwh is None:\n",
        "            annual_kwh = _f(_first([\n",
        "                r\"E_Load\\b[^\\d\\n]{0,10}(?:\\d+(?:\\.\\d+)?\\s+){1,12}(\\d{4,6})\\s+0\\.\\d\",\n",
        "                r\"E_Load\\b[^\\n]{0,500}?(\\d{4,6})\\s*kWh\",\n",
        "                r\"User.s\\s+needs[^\\d]{0,200}?(\\d{4,6})\\s*kWh\",\n",
        "                r\"Energy\\s+need\\s+of\\s+the\\s+user[^\\d]{0,200}?(\\d{4,6})\\s*kWh\",\n",
        "            ], t))\n",
        "\n",
        "        # Carga promedio: SIEMPRE E_Load_year / 8760\n",
        "        avg_kw = round(annual_kwh / 8760, 3) if annual_kwh else None\n",
        "        return {\"average_kw\": avg_kw, \"annual_kwh\": annual_kwh}\n",
        "\n",
        "    def _energy(self, t):\n",
        "        e_miss = _f(_first([\n",
        "            r\"(?:Missing\\s+Energy|E_Miss)[^\\d]{0,400}?(\\d{4,6})\\s*(?:kWh|0\\.\\d)\",\n",
        "            r\"(?:Missing\\s+energy|Not-met\\s+load)[^\\d]{0,200}?(\\d{4,6})\\s*kWh\",\n",
        "        ], t))\n",
        "        e_user = _f(_first([\n",
        "            r\"Useful\\s+energy\\s+from\\s+solar[^\\d]{0,200}?(\\d{4,6})\\s*kWh\",\n",
        "            r\"E_User[^\\d]{0,400}?(\\d{4,6})\\s*(?:kWh|0\\.\\d)\",\n",
        "            r\"Energy\\s+supplied\\s+to\\s+the\\s+user[^\\d]{0,200}?(\\d{4,6})\\s*kWh\",\n",
        "        ], t))\n",
        "        e_avail = _f(_first([\n",
        "            r\"Available\\s+[Ss]olar\\s+[Ee]nergy[^\\d]{0,200}?(\\d{4,6})\\s*kWh\",\n",
        "            r\"E_Avail[^\\d]{0,400}?(\\d{4,6})\\s*(?:kWh|0\\.\\d)\",\n",
        "        ], t))\n",
        "        sf = _f(_first([\n",
        "            r\"Solar\\s+Fraction\\s+SF\\s+(\\d+\\.\\d+)\",\n",
        "            r\"SolFrac[^\\d]{0,100}(0\\.\\d+)\",\n",
        "        ], t))\n",
        "        cycles  = _f(_first([r\"Cycles\\s+SOW[^\\d]{0,50}(\\d+\\.?\\d*)\",\n",
        "                              r\"Nb\\.\\s*cycles[^\\d]{0,50}(\\d+\\.?\\d*)\"], t))\n",
        "        bat_life = _f(_first([r\"Battery\\s+lifetime[^\\d]{0,50}(\\d+\\.?\\d*)\\s*years\"], t))\n",
        "        return {\"e_miss\": e_miss, \"e_user\": e_user, \"e_avail\": e_avail,\n",
        "                \"sol_frac\": sf, \"cycles\": cycles, \"bat_life\": bat_life}\n",
        "\n",
        "    def show_summary(self):\n",
        "        d  = self.data\n",
        "        p  = d[\"panels\"];  b  = d[\"batteries\"]; iv = d[\"inverter\"]\n",
        "        lo = d[\"losses\"];  ld = d[\"load\"];       e  = d[\"energy\"]\n",
        "        s  = d[\"site\"];    bt = d[\"battery_temp\"]\n",
        "\n",
        "        def _v(v, unit=\"\", fb=\"—\"):\n",
        "            return f\"{v} {unit}\".strip() if v is not None else fb\n",
        "\n",
        "        cap_per_bat = None\n",
        "        if b[\"capacity_ah\"] and b[\"count\"]:\n",
        "            cap_per_bat = round(b[\"capacity_ah\"] / b[\"count\"], 1)\n",
        "\n",
        "        print(\"┌─ DATOS EXTRAÍDOS DEL PDF PVsyst ──────────────────────────────┐\")\n",
        "        print(f\"│  Proyecto  : {d['project']['name'] or '—'}\")\n",
        "        print(f\"│  Variante  : {d['variant']['name'] or '—'}\")\n",
        "        print(f\"│  Sitio/País: {s['name'] or '—'}  /  {s['country'] or '—'}\")\n",
        "        print(\"├────────────────────────────────────────────────────────────────┤\")\n",
        "        print(f\"│  PANELES   : {_v(p['count'],'u.')}  │  {_v(p['power_wp'],'Wp')}  │  {_v(p['total_kwp'],'kWp')}\")\n",
        "        print(f\"│  Config.   : {_v(p['n_series'],'serie')} × {_v(p['n_parallel'],'paralelo')}  │  {p['model'] or '—'}\")\n",
        "        print(\"├────────────────────────────────────────────────────────────────┤\")\n",
        "        print(f\"│  BATERÍAS  : {_v(b['count'],'packs')}  │  Cap. total: {_v(b['capacity_ah'],'Ah')}  \"\n",
        "              f\"│  ({_v(cap_per_bat,'Ah/pack')})\")\n",
        "        print(f\"│  SOC mín.  : {_v(b['soc_min_pct'],'%')}  │  Temp. diseño: {_v(bt['design_temp_c'],'°C')}  │  {b['model'] or '—'}\")\n",
        "        print(\"├────────────────────────────────────────────────────────────────┤\")\n",
        "        print(f\"│  MPPT ctrl.: {_v(iv['total_mppt'],'u.')}  │  {iv['model'] or '—'}\")\n",
        "        print(\"├────────────────────────────────────────────────────────────────┤\")\n",
        "        #print(f\"│  CARGA     : {_v(ld['average_kw'],'kW prom.')}  │  {_v(ld['annual_kwh'],'kWh/año')}\")\n",
        "        print(\"├────────────────────────────────────────────────────────────────┤\")\n",
        "        print(f\"│  PÉRDIDAS  : Soiling factor = {_v(lo['soiling_pct'],'%')}  \"\n",
        "              f\"│  Temp. PV = {_v(lo['temp_pv_pct'],'%')}\")\n",
        "        print(\"├────────────────────────────────────────────────────────────────┤\")\n",
        "        print(f\"│  ENERGÍA   : E_Miss={_v(e['e_miss'],'kWh')}  │  E_User={_v(e['e_user'],'kWh')}  \"\n",
        "              f\"│  FracSolar={_v(e['sol_frac'])}\")\n",
        "        print(f\"│  Ciclos    : {_v(e['cycles'])}  │  Vida batería: {_v(e['bat_life'],'años')}\")\n",
        "        print(\"└────────────────────────────────────────────────────────────────┘\")\n",
        "\n",
        "        missing = []\n",
        "        if p[\"count\"]          is None: missing.append(\"cantidad de paneles\")\n",
        "        if b[\"count\"]          is None: missing.append(\"cantidad de baterías (packs)\")\n",
        "        if b[\"capacity_ah\"]    is None: missing.append(\"capacidad total de batería (Ah)\")\n",
        "        if b[\"soc_min_pct\"]    is None: missing.append(\"SOC mínimo de descarga\")\n",
        "        if iv[\"total_mppt\"]    is None: missing.append(\"cantidad de MPPTs\")\n",
        "        if ld[\"average_kw\"]    is None: missing.append(\"carga promedio (kW)\")\n",
        "        if lo[\"soiling_pct\"]   is None: missing.append(\"Soiling loss factor (%)\")\n",
        "        if bt[\"design_temp_c\"] is None: missing.append(\"temperatura de diseño batería (°C)\")\n",
        "        if e[\"e_miss\"]         is None: missing.append(\"energía faltante E_Miss (kWh/año)\")\n",
        "        if missing:\n",
        "            print(\"\\n⚠️  Campos NO extraídos automáticamente:\")\n",
        "            for m in missing:\n",
        "                print(f\"     • {m}\")\n",
        "\n",
        "    def raw_text_debug(self, chars=4000):\n",
        "        return self.full_text[:chars]\n",
        "\n",
        "\n",
        "print(\"✅ Clase PVsystPDFParser v3 definida\")\n",
        "\n",
        "\n",
        "\n",
        "\n"
      ],
